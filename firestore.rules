rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // exists() d'abord : un compte qui crée son profil n'en a pas encore, et
    // un get() sur un document absent ferait échouer toute la règle.
    function userTypes() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().data.userTypes is list
        ? currentUserDoc().data.userTypes
        : [];
    }

    function isAdmin() {
      return isSignedIn() && "admin" in userTypes();
    }

    function isAdminOrManager() {
      return isSignedIn() &&
        (
          "admin" in userTypes() ||
          "gestionnaire" in userTypes()
        );
    }

    function isTeamLead() {
      return isSignedIn() && "chef_equipe" in userTypes();
    }

    function isBudgetManager() {
      return isSignedIn() && "budget" in userTypes();
    }

    function isMeetingDirector() {
      return isSignedIn() && "meeting_director" in userTypes();
    }

    function isAthleteTransportChief() {
      return isSignedIn() && "chef_transport_athletes" in userTypes();
    }

    // Commission des athlètes : pilote les courses nationales du pré-programme
    // (sélection et décisions), sans accès aux U12/U14 ni aux bénévoles.
    function isAthleteCommission() {
      return isSignedIn() && "commission_athletes" in userTypes();
    }

    function canManageNationalRaces() {
      return isAdmin() || isAthleteCommission();
    }

    function isPhysio() {
      return isSignedIn() && "kine" in userTypes();
    }

    function isAthleteTransportVolunteer() {
      return isSignedIn() && "benevole_transport_athletes" in userTypes();
    }

    // Rôles autorisés par appSettings/athletePortalSettings.accessRoles
    // (voir DEFAULT_PORTAL_SETTINGS dans athlete-portal-hooks.js) : la
    // gestion de la base et l'écriture restent réservées à admin/gestionnaire
    // et au meeting_director, la lecture s'étend aussi au transport athlètes
    // qui a besoin de voir la liste pour ses propres pages.
    function canReadAthletePortal() {
      return isAdminOrManager() || isMeetingDirector() ||
        isAthleteTransportChief() || isAthleteTransportVolunteer();
    }

    function canManageAthletePortal() {
      return isAdminOrManager() || isMeetingDirector();
    }

    // Bénévole/chef d'équipe affecté à l'équipe "Guides VIP" : peut lire les
    // inscriptions VIP (pas les modifier) pour retrouver ses invités à guider,
    // filtré côté client par tour (coque/coulisses) via son sous-rôle.
    // Le profil (users/{uid}) stocke l'équipe sous assignedTeams (liste) et/ou
    // assignedRole (rôle principal) — voir syncVolunteerAssignmentToUserProfile()
    // dans App.jsx. Une affectation encore provisoire (mail pas envoyé) reste
    // visible, juste marquée comme telle côté UI (cf. MyAssignmentsPage) — pas
    // de blocage d'accès ici.
    function isVipTourGuide() {
      return isSignedIn() &&
        (
          currentUserDoc().data.assignedRole == "Guides VIP" ||
          (
            currentUserDoc().data.assignedTeams is list &&
            "Guides VIP" in currentUserDoc().data.assignedTeams
          )
        );
    }

    // Une personne non admin/gestionnaire/budget peut être autorisée
    // individuellement (ou via son rôle) à déposer des factures, via
    // appSettings/budgetInvoiceConfiguration (configuré par un admin).
    function canManageInvoiceViaConfig() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/appSettings/budgetInvoiceConfiguration) &&
        (
          (
            get(/databases/$(database)/documents/appSettings/budgetInvoiceConfiguration).data.allowedUploaderUserIds is list &&
            request.auth.uid in get(/databases/$(database)/documents/appSettings/budgetInvoiceConfiguration).data.allowedUploaderUserIds
          ) ||
          (
            get(/databases/$(database)/documents/appSettings/budgetInvoiceConfiguration).data.allowedUploaderRoles is list &&
            get(/databases/$(database)/documents/appSettings/budgetInvoiceConfiguration).data.allowedUploaderRoles.hasAny(userTypes())
          )
        );
    }

    // Budget et factures : admin et rôle « budget » seulement (décision de
    // Margot du 10/11/2026 : les gestionnaires — dont les étudiants LUNEX —
    // voient toute la gestion sauf le budget). Le dépôt d'une facture reste
    // ouvert aux personnes autorisées dans Réglages (canManageInvoiceViaConfig).
    function canManageBudget() {
      return isAdmin() || isBudgetManager();
    }

    function canManageInvoices() {
      return canManageBudget() || canManageInvoiceViaConfig();
    }

    function isInvoiceDocument(res) {
      return res != null && res.data.get("documentType", "document") == "invoice";
    }

    function isWebsiteManager() {
      return isSignedIn() &&
        (
          "admin" in userTypes() ||
          "gestionnaire" in userTypes() ||
          "gestionnaire_site" in userTypes()
        );
    }

    // ── Caisse jour J ────────────────────────────────────────────────────────
    // Session technique d'un ordinateur de caisse, ouverte par code via la
    // Cloud Function openCashPostSession (claims cashPostId +
    // cashAccessVersion). Elle n'est valide que si le poste est actif et que
    // sa version d'accès n'a pas changé depuis (régénérer le code coupe
    // immédiatement les sessions déjà ouvertes).
    function cashPostIdClaim() {
      return isSignedIn() && request.auth.token.cashPostId is string
        ? request.auth.token.cashPostId
        : "";
    }

    function cashPostDoc() {
      return get(/databases/$(database)/documents/cashPosts/$(cashPostIdClaim()));
    }

    function isValidCashSession() {
      return cashPostIdClaim() != "" &&
        exists(/databases/$(database)/documents/cashPosts/$(cashPostIdClaim())) &&
        cashPostDoc().data.get("active", true) == true &&
        cashPostDoc().data.get("accessVersion", 0) == request.auth.token.cashAccessVersion;
    }

    function isVipCashSession() {
      return isValidCashSession() && cashPostDoc().data.get("showVipLists", false) == true;
    }

    // ── Attribution des rôles ────────────────────────────────────────────────
    // Rôles qu'un compte peut s'attribuer seul : ceux que posent les
    // formulaires publics (bénévole, parent pré-programme, athlète des
    // courses nationales).
    function selfServiceRoles() {
      return ["benevole", "parent_u14", "athlete_preprogram"];
    }

    // Rôles transport que la synchronisation des équipes (App.jsx,
    // syncVolunteerAssignmentToUserProfile) ajoute ou retire, y compris
    // quand un gestionnaire affecte un bénévole.
    function managerGrantableRoles() {
      return selfServiceRoles().concat(["benevole_transport_athletes", "chef_transport_athletes"]);
    }

    // Anciens champs que extractUserTypes() convertit encore en rôles côté
    // client : seul un admin peut les écrire.
    function legacyRoleFlagKeys() {
      return ["isAdmin", "isManager", "isTeamLead", "isParentU14", "isVolunteer", "roles", "role", "userType"];
    }

    function newUserTypes() {
      return request.resource.data.get("userTypes", []).toSet();
    }

    function oldUserTypes() {
      return resource.data.get("userTypes", []).toSet();
    }

    function addedUserTypes() {
      return newUserTypes().difference(oldUserTypes());
    }

    function changedUserTypes() {
      return addedUserTypes().union(oldUserTypes().difference(newUserTypes()));
    }

    // Activation d'une invitation (invite-page.jsx) : le profil cite
    // l'invitation, qui doit être en attente, non expirée, adressée à l'email
    // du compte, et ne peut accorder que les rôles qu'elle contient.
    function isInvitationRoleGrant() {
      let invitationId = request.resource.data.get("invitationId", "");
      let invitationPath = /databases/$(database)/documents/invitations/$(invitationId);
      let invitation = get(invitationPath).data;
      return invitationId is string && invitationId != "" &&
        exists(invitationPath) &&
        invitation.status == "pending" &&
        invitation.expiresAt > request.time &&
        request.auth.token.email != null &&
        invitation.email == request.auth.token.email.lower() &&
        newUserTypes().hasOnly(invitation.roles.concat(selfServiceRoles()));
    }

    function isParentOwnerCreate() {
      return isSignedIn() &&
        request.resource.data.parentUserId == request.auth.uid;
    }

    function isParentOwnerExisting() {
      return isSignedIn() &&
        resource.data.parentUserId == request.auth.uid;
    }

    match /users/{userId} {
      // Le chef transport athlètes doit pouvoir lister les bénévoles
      // transport pour les affecter à un lot (VolunteersTab) — restreint à
      // ce même rôle cible pour ne pas exposer tous les profils.
      allow read: if isOwner(userId) || isAdminOrManager() ||
        (isAthleteTransportChief() &&
         resource.data.userTypes is list &&
         "benevole_transport_athletes" in resource.data.userTypes);
      // Les rôles (userTypes) portent tous les droits : un compte ne peut pas
      // s'en donner lui-même au-delà des parcours d'inscription publics. Les
      // autres rôles viennent d'un admin (page Rôles), d'une invitation encore
      // valide adressée à son email, ou pour un gestionnaire des seuls rôles
      // transport synchronisés depuis les équipes.
      allow create: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.keys().hasAny(legacyRoleFlagKeys()) &&
         (newUserTypes().hasOnly(selfServiceRoles()) || isInvitationRoleGrant()));
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(legacyRoleFlagKeys()) &&
         addedUserTypes().hasOnly(selfServiceRoles())) ||
        (isAdminOrManager() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(legacyRoleFlagKeys()) &&
         changedUserTypes().hasOnly(managerGrantableRoles()));
      allow delete: if isAdmin();
    }

    // Notifications (cloche) : écrites uniquement par le serveur
    // (functions/src/notifications.js) ; la personne peut seulement les lire,
    // les marquer comme lues et les supprimer.
    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);
    }

    // Appareils activés pour le push (un document par jeton FCM).
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    // ── Portail athlètes ─────────────────────────────────────────────────────
    // Manquait complètement (tombait dans le catch-all admin-only), ce qui
    // bloquait meeting_director et le transport athlètes malgré des routes
    // et un appSettings/athletePortalSettings.accessRoles qui leur donnent
    // explicitement accès à ce module.
    match /athletes/{athleteId} {
      allow read: if canReadAthletePortal();
      allow write: if canManageAthletePortal();
    }

    match /athleteRegistry/{entryId} {
      allow read: if canReadAthletePortal();
      allow write: if canManageAthletePortal();
    }

    // Coachs/physios/famille listés par le meeting director à côté des
    // athlètes (mêmes fichiers, mêmes infos de voyage) mais qui ne concourent
    // pas — mêmes droits que /athletes puisque c'est le même import qui les
    // alimente.
    match /athleteAccompanyingPersons/{personId} {
      allow read: if canReadAthletePortal();
      allow write: if canManageAthletePortal();
    }

    // Historique des imports Excel du meeting director : lecture ouverte à
    // qui a accès au portail athlètes, écriture réservée à qui importe.
    match /athleteImportHistory/{entryId} {
      allow read: if canReadAthletePortal();
      allow create: if canManageAthletePortal();
      allow update, delete: if canManageAthletePortal();
    }

    match /athleteTransportLots/{lotId} {
      allow read: if canReadAthletePortal();
      allow create, delete: if canManageAthletePortal() || isAthleteTransportChief();
      // Le bénévole assigné peut cocher/décocher pickedUp pour son propre lot.
      allow update: if canManageAthletePortal() || isAthleteTransportChief() ||
        (isAthleteTransportVolunteer() && resource.data.assignedVolunteerId == request.auth.uid);
    }

    // siteEditionYear pilote quelle édition est visible sur le site public,
    // et doit rester modifiable par un gestionnaire_site (pas seulement
    // admin/gestionnaire) — voir WebsiteEditionPage / setSiteEditionYear().
    // Les autres champs de ce doc (activeEdition, préprogramme, rôles
    // bénévoles) restent réservés à admin/gestionnaire.
    match /appSettings/platform {
      allow read: if true;
      allow write: if isAdminOrManager() ||
        (isWebsiteManager() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["siteEditionYear", "updatedAt"]));
    }

    // Éditions du meeting : lecture publique (timetable, résultats, e-magazine
    // affichés à tous sur le site), écriture réservée aux gestionnaires du site.
    match /meetingEditions/{editionId} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    // Historique du meeting (records, vainqueurs, résultats) : affiché à tous
    // sur la page publique Results & Statistics et dans le e-magazine
    // (bandeau record du meeting). Sans ces règles, seuls admin/gestionnaire
    // pouvaient les lire (règle générale) et les visiteurs ne voyaient rien.
    // L'écriture reste celle de la règle générale (admin/gestionnaire).
    match /meetingRecords/{recordId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    match /meetingWinners/{winnerId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    match /meetingResults/{resultId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    // ── Audience du e-magazine (chiffres pour les sponsors) ──────────────────
    // Écrite par les lecteurs anonymes du site (src/site/emagazine-stats.js) :
    // uniquement des compteurs qui montent de 0 ou 1 à chaque écriture, plus
    // le titre de la page et l'horodatage. Lecture : gestionnaires du site.
    function statCreatedByAtMostOne(field) {
      return request.resource.data.get(field, 0) in [0, 1];
    }

    function statBumpedByAtMostOne(field) {
      return request.resource.data.get(field, 0) is int &&
        request.resource.data.get(field, 0) - resource.data.get(field, 0) in [0, 1];
    }

    function statWriteIsTimestamped() {
      return request.resource.data.updatedAt == request.time;
    }

    match /emagazineStats/{year} {
      allow read: if isWebsiteManager();
      allow create: if year.matches('^[0-9]{4}$') && statWriteIsTimestamped() &&
        request.resource.data.keys().hasOnly(["opens", "uniqueReaders", "prints", "updatedAt"]) &&
        statCreatedByAtMostOne("opens") && statCreatedByAtMostOne("uniqueReaders") &&
        statCreatedByAtMostOne("prints");
      allow update: if statWriteIsTimestamped() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["opens", "uniqueReaders", "prints", "updatedAt"]) &&
        statBumpedByAtMostOne("opens") && statBumpedByAtMostOne("uniqueReaders") &&
        statBumpedByAtMostOne("prints");
      allow delete: if isAdminOrManager();

      match /pages/{pageId} {
        allow read: if isWebsiteManager();
        allow create: if statWriteIsTimestamped() &&
          request.resource.data.keys().hasOnly(["views", "title", "updatedAt"]) &&
          request.resource.data.views == 1 &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200;
        allow update: if statWriteIsTimestamped() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views", "title", "updatedAt"]) &&
          request.resource.data.views == resource.data.views + 1 &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200;
        allow delete: if isAdminOrManager();
      }

      match /days/{day} {
        allow read: if isWebsiteManager();
        allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && statWriteIsTimestamped() &&
          request.resource.data.keys().hasOnly(["opens", "updatedAt"]) &&
          request.resource.data.opens == 1;
        allow update: if statWriteIsTimestamped() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["opens", "updatedAt"]) &&
          request.resource.data.opens == resource.data.opens + 1;
        allow delete: if isAdminOrManager();
      }
    }

    // Composition des équipes : lue par tous les bénévoles/chefs d'équipe pour
    // afficher leurs affectations, missions et documents d'équipe.
    // Programme du jour du meeting (grille du dimanche) : lu par tout compte
    // connecté (bénévoles et chefs d'équipe y voient leur équipe), modifié par
    // les organisateurs.
    match /meetingDayProgrammes/{programmeId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    // Équipes de l'organisation (staff, communication, LUNEX, Apex…) : elles
    // contiennent les e-mails et téléphones du staff → admins et gestionnaires.
    match /appSettings/organisationTeams {
      allow read, write: if isAdminOrManager();
    }

    // Fiche d'un membre de l'organisation (identifiant = son e-mail) : ses
    // équipes, pour « Mon planning ». Lisible par lui seul ; recopiée par les
    // admins et gestionnaires à chaque enregistrement des équipes.
    match /organisationMembers/{memberEmail} {
      allow read: if isAdminOrManager() ||
        (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == memberEmail);
      allow write: if isAdminOrManager();
    }

    // Rétroplanning : admins et gestionnaires gèrent tout ; un membre d'une
    // équipe de l'organisation (son e-mail est dans perimeterEmails, recalculé
    // à chaque enregistrement des équipes) lit les tâches de son périmètre et
    // peut seulement en changer le statut.
    function isInTaskPerimeter(data) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in data.perimeterEmails;
    }

    match /meetingTasks/{taskId} {
      allow read: if isAdminOrManager() || isInTaskPerimeter(resource.data);
      allow create, delete: if isAdminOrManager();
      allow update: if isAdminOrManager() ||
        (isInTaskPerimeter(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]) &&
         request.resource.data.status in ["todo", "doing", "done"]);
    }

    match /appSettings/teamsConfiguration {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    // Réglages du portail athlètes (rôles d'accès, champs visibles par rôle) :
    // lus par la barre de navigation de TOUS les connectés pour savoir s'il
    // faut afficher le menu Athlètes. Sans cette règle, un bénévole recevait un
    // refus, et ce refus (combiné au double abonnement du mode dev) plantait
    // le SDK Firestore (« INTERNAL ASSERTION FAILED: ca9 ») → page d'erreur.
    // Aucune donnée personnelle dedans ; l'écriture reste admin/meeting director.
    match /appSettings/athletePortalSettings {
      allow read:  if isSignedIn();
      allow write: if canManageAthletePortal();
    }

    // Configuration des autorisations de dépôt de facture : doit être lisible
    // par tout utilisateur connecté pour savoir s'il est lui-même autorisé.
    match /appSettings/budgetInvoiceConfiguration {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    // ── Candidatures bénévoles ───────────────────────────────────────────────
    // Manquait complètement → tombait dans le catch-all (admin/manager only)
    match /volunteerApplications/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdminOrManager() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdminOrManager() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /u14Children/{childId} {
      allow create: if isParentOwnerCreate() || isAdminOrManager();
      allow read:   if isParentOwnerExisting() || isAdminOrManager();
      allow update: if isParentOwnerExisting() || isAdminOrManager();
      allow delete: if isAdminOrManager();
    }

    match /u14Requests/{requestId} {
      allow create: if isParentOwnerCreate() || isAdminOrManager();
      allow read:   if isParentOwnerExisting() || isAdminOrManager();
      allow update: if isParentOwnerExisting() || isAdminOrManager();
      allow delete: if isAdminOrManager();
    }

    // Courses nationales du pré-programme (adultes) : l'athlète crée et lit ses
    // propres demandes ; il ne peut ensuite que se désister. Sélection, liste
    // d'attente, mails et suivi SELTEC restent à la commission et aux admins.
    match /nationalRaceRequests/{requestId} {
      allow create: if (isSignedIn() &&
          request.resource.data.athleteUserId == request.auth.uid &&
          request.resource.data.status == "submitted") ||
        canManageNationalRaces();
      // Caisse jour J : les postes (et l'orga) lisent les athlètes retenus pour
      // remettre le ticket gratuit de l'accompagnateur, jamais les autres demandes.
      allow read: if (isSignedIn() && resource.data.athleteUserId == request.auth.uid) || canManageNationalRaces() ||
        ((isAdminOrManager() || isValidCashSession()) && resource.data.status == "selected");
      allow update: if canManageNationalRaces() ||
        (isSignedIn() &&
         resource.data.athleteUserId == request.auth.uid &&
         request.resource.data.status == "withdrawn" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "withdrawnAt", "updatedAt"]));
      allow delete: if canManageNationalRaces();
    }

    // Séries et couloirs par course et par édition : l'admin fixe le nombre
    // de séries / couloirs, la commission le lit pour placer les retenus
    // (champs heat / lane des demandes, déjà couverts par la règle ci-dessus).
    match /nationalRaceConfigs/{editionId} {
      allow read: if canManageNationalRaces();
      allow write: if isAdmin();
    }

    // Modèles de mails des décisions (retenu / attente / non retenu).
    match /appSettings/nationalRaceMailTemplates {
      allow read, write: if canManageNationalRaces();
    }

    // Places protégées pré-programme : manquait complètement (tombait dans le
    // catch-all admin-only), ce qui empêchait un parent de libérer sa place
    // protégée quand il se désiste (my-children-page.jsx handleDeclineAttendance).
    // La lecture reste admin-only (les places non affectées ne concernent pas
    // les autres parents) ; seul le parent déjà lié à une place peut la modifier,
    // pour la libérer.
    // Invitations des places protégées : l'identifiant du document est le
    // jeton du lien envoyé à la famille. On peut lire une invitation dont on
    // a le lien (get), jamais lister les autres. La confirmation passe par la
    // fonction claimU14ProtectedInvite (droits serveur).
    match /u14ProtectedInvites/{token} {
      allow get: if true;
      allow list, create, update, delete: if isAdminOrManager();
    }

    // Réserves et date limite des places protégées, et infos pratiques
    // U12/U14 : lues par les parents (formulaire d'invitation, mail de
    // confirmation, espace « Mes enfants »), modifiées par l'équipe.
    match /appSettings/u14ProtectedSettings {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /appSettings/u14PracticalInfo {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /u14ProtectedEntries/{entryId} {
      allow read:   if isAdminOrManager();
      allow create, delete: if isAdminOrManager();
      allow update: if isAdminOrManager() ||
        (isSignedIn() && resource.data.matchedParentUserId == request.auth.uid);
    }

    match /vipPublicRegistrations/{registrationId} {
      allow create: if true;
      allow read: if isAdminOrManager() || isVipTourGuide() || isVipCashSession();
      allow update, delete: if isAdminOrManager();
    }

    match /vipInvitations/{invitationId} {
      allow read, write: if isAdminOrManager();
    }

    // ── Invitations plateforme ───────────────────────────────────────────────
    // L'id du document est le token UUID du lien d'activation : qui a reçu le
    // lien peut lire son invitation (get) sans être connecté, mais personne
    // d'autre qu'un admin ne peut lister la collection (emails, rôles, tokens).
    // Le token envoyé par mail prouve aussi que la personne lit cette boîte :
    // c'est ce qui remplace la vérification d'email que Firebase Auth ne fait
    // pas, avant que le profil cite l'invitation (isInvitationRoleGrant).
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAdmin();
      // Une invitation accorde des rôles : seuls les admins la créent ou la
      // modifient (la page Invitations leur est réservée). La personne invitée
      // peut seulement la marquer acceptée, sans toucher aux rôles.
      allow create: if isAdmin() && request.resource.data.token == invitationId;
      allow delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
         resource.data.email == request.auth.token.email.lower() &&
         resource.data.status == "pending" &&
         request.resource.data.status == "accepted" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt", "acceptedByUid"]));
    }

    match /vipAdminRegistrations/{registrationId} {
      allow read: if isAdminOrManager() || isVipTourGuide() || isVipCashSession();
      allow write: if isAdminOrManager();
    }

    // Doc public : jamais de mot de passe en clair ici (seulement organisation,
    // contact et l'indicateur "hasPassword"). Le mot de passe réel vit dans
    // vipPartnerPortalSecrets, jamais lu par le client, seulement par la
    // Cloud Function verifyVipPortalAccess (SDK admin, contourne ces règles).
    match /vipPartnerPortals/{portalId} {
      allow read: if true;
      allow write: if isAdminOrManager();
    }

    match /vipPartnerPortalSecrets/{portalId} {
      allow read, write: if isAdminOrManager();
    }

    // Accès réservé aux admins/gestionnaires, ou à la session obtenue via
    // verifyVipPortalAccess après vérification du mot de passe côté serveur
    // (custom claim vipPortalId posé sur le compte technique du portail).
    match /vipPartnerPortals/{portalId}/entries/{entryId} {
      allow read: if isAdminOrManager() || isVipTourGuide() || isVipCashSession() ||
        (isSignedIn() && request.auth.token.vipPortalId == portalId);
      allow create, update, delete: if isAdminOrManager() ||
        (isSignedIn() && request.auth.token.vipPortalId == portalId);
    }

    // ── Kiné ────────────────────────────────────────────────────────────────
    // Chaque kiné gère ses propres plages d'ouverture ; tous les kinés voient
    // et gèrent toutes les réservations (planning commun). Les athlètes
    // réservent via les Cloud Functions de l'espace athlète (athlete-hub.js).
    match /physioSessions/{sessionId} {
      allow read: if isAdminOrManager() || isPhysio();
      allow create: if isAdminOrManager() ||
        (isPhysio() && request.resource.data.physioUid == request.auth.uid);
      allow update, delete: if isAdminOrManager() ||
        (isPhysio() && resource.data.physioUid == request.auth.uid);
    }

    match /physioBookings/{bookingId} {
      allow read, write: if isAdminOrManager() || isPhysio();
    }

    // Limite d'essais d'identification : Cloud Functions uniquement.
    match /athleteHubAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ── Roadbook athlètes ───────────────────────────────────────────────────
    // Page publique /athletes/roadbook : lisible par tous une fois publiée,
    // le brouillon reste réservé aux admins/gestionnaires (aperçu ?preview=1).
    match /athleteRoadbooks/{editionId} {
      allow read: if resource.data.status == "published" || isAdminOrManager();
      allow write: if isAdminOrManager();
    }

    // ── Caisse jour J ────────────────────────────────────────────────────────
    // Chaque ordinateur de caisse ne lit que son propre poste.
    match /cashPosts/{postId} {
      allow read: if isAdminOrManager() || cashPostIdClaim() == postId;
      allow write: if isAdminOrManager();
    }

    // Hash des codes : écrit et lu uniquement par les Cloud Functions.
    match /cashPostSecrets/{postId} {
      allow read, write: if false;
    }

    match /cashAccessAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /doorGuestLists/{listId} {
      allow read: if isAdminOrManager() || isValidCashSession();
      allow write: if isAdminOrManager();
    }

    match /doorGuests/{guestId} {
      allow read: if isAdminOrManager() || isValidCashSession();
      allow write: if isAdminOrManager();
    }

    // Un check-in par invité et par édition (id déterministe), partagé par
    // tous les postes pour bloquer une double entrée. Le poste qui écrit doit
    // se déclarer comme dernier poste.
    match /doorCheckIns/{checkInId} {
      allow read: if isAdminOrManager() || isValidCashSession();
      allow create, update: if isAdminOrManager() ||
        (isValidCashSession() && request.resource.data.lastPostId == cashPostIdClaim());
      allow delete: if isAdminOrManager();
    }

    // ── Module Communication (porté de myFLA) ────────────────────────────────
    // Calendrier éditorial, publications, rubriques, événements, tâches,
    // infos privées des partenaires et contreparties : réservé à
    // l'organisation (admin, gestionnaire). Le champ `validation` d'une
    // publication est écrit par la Cloud Function comPublicationValidation ;
    // la règle générale en fin de fichier (admin/gestionnaire : tout) empêche
    // d'en faire un verrou strict, le refus ci-dessous évite surtout les erreurs.
    function comPublicationIsValid() {
      return request.resource.data.titre is string &&
        request.resource.data.titre.size() <= 200 &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (!('texte' in request.resource.data) || request.resource.data.texte == null ||
          (request.resource.data.texte is string && request.resource.data.texte.size() <= 10000)) &&
        (!('notes' in request.resource.data) || request.resource.data.notes == null ||
          (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000));
    }

    match /com_publications/{publicationId} {
      allow read, delete: if isAdminOrManager();
      allow create: if isAdminOrManager() && comPublicationIsValid() &&
        !('validation' in request.resource.data);
      allow update: if isAdminOrManager() && comPublicationIsValid() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["validation"]);
    }

    match /com_rubriques/{rubriqueId} {
      allow read, write: if isAdminOrManager();
    }

    match /com_events/{eventId} {
      allow read, write: if isAdminOrManager();
    }

    match /com_tasks/{taskId} {
      allow read, write: if isAdminOrManager();
    }

    // Contact, contrat et notes des partenaires : jamais dans siteSponsors,
    // qui est public (logos du site).
    match /com_partner_details/{sponsorId} {
      allow read, write: if isAdminOrManager();
    }

    match /com_obligations/{obligationId} {
      allow read, write: if isAdminOrManager();
    }

    // ── Documents partagés ──────────────────────────────────────────────────
    // Lecture ouverte aux bénévoles et chefs d'équipe (actuellement bloqué par catch-all)
    match /documents/{docId} {
      allow read:   if isSignedIn();
      // Documents : admins et gestionnaires ; factures : budget seulement.
      allow write:  if canManageBudget() ||
        (isAdminOrManager() && !isInvoiceDocument(resource) && !isInvoiceDocument(request.resource));
      // Un chef d'équipe peut publier des documents pour son équipe et retirer
      // uniquement ceux qu'il a lui-même ajoutés (pas les documents admin/globaux).
      allow create: if (
        isTeamLead() &&
        request.resource.data.documentType == "document" &&
        request.resource.data.scope == "teams" &&
        request.resource.data.uploadedByUid == request.auth.uid
      ) || (
        canManageInvoices() &&
        request.resource.data.documentType == "invoice" &&
        request.resource.data.uploadedByUid == request.auth.uid
      );
      // Le classement d'une facture (lier/délier une ligne de budget) doit rester
      // possible pour les mêmes personnes autorisées à déposer des factures.
      allow update: if canManageInvoices() && resource.data.documentType == "invoice";
      // Toute personne autorisée à déposer une facture (pas seulement chef
      // d'équipe) doit pouvoir retirer celle qu'elle a elle-même déposée.
      allow delete: if (isTeamLead() && resource.data.uploadedByUid == request.auth.uid) ||
        (canManageInvoices() && resource.data.documentType == "invoice" && resource.data.uploadedByUid == request.auth.uid);
    }

    // ── Budget ────────────────────────────────────────────────────────────────
    // Le rôle "budget" pilote le module budget/factures sans être gestionnaire.
    match /budgets/{document=**} {
      allow read, write: if canManageBudget();
    }

    // ── Décomptes (remboursements) ──────────────────────────────────────────
    // Ils contiennent un IBAN : la personne elle-même, les admins et le rôle
    // budget seulement. La personne crée et envoie le sien ; un décompte
    // préparé par l'organisation garde son motif, ses lignes et son acompte ;
    // seuls admin/budget font avancer le suivi (vérifié, transmis, payé).
    function isOwnClaim(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function ownerEditableStatus(status) {
      return status in ["draft", "preset", "rejected"];
    }

    match /expenseClaims/{claimId} {
      allow read: if canManageBudget() || isOwnClaim(resource.data);
      allow create: if canManageBudget() ||
        (isOwnClaim(request.resource.data) && request.resource.data.status in ["draft", "submitted"]);
      allow update: if canManageBudget() ||
        (isOwnClaim(resource.data) &&
         isOwnClaim(request.resource.data) &&
         ownerEditableStatus(resource.data.status) &&
         request.resource.data.status in ["draft", "preset", "rejected", "submitted"] &&
         (resource.data.status != "preset" ||
          (request.resource.data.reason == resource.data.reason &&
           request.resource.data.lines == resource.data.lines &&
           request.resource.data.advance == resource.data.advance &&
           request.resource.data.preset == resource.data.preset)));
      allow delete: if canManageBudget() || (isOwnClaim(resource.data) && resource.data.status == "draft");
    }

    // Profil privé (adresse, IBAN, banque) réutilisé d'un décompte à l'autre.
    match /userPrivate/{userId} {
      allow read: if isOwner(userId) || canManageBudget();
      allow write: if isOwner(userId);
    }

    // ── Site public (gestion contenu) ───────────────────────────────────────
    match /siteSponsors/{docId} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    match /siteNews/{docId} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    match /sitePressReleases/{docId} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    // Requêtes « collection group » sur les inscrits des portails VIP (admin VIP,
    // espace bénévole) : avant, couvertes par l'ancienne règle générale /{document=**}.
    match /{path=**}/entries/{entryId} {
      allow read: if isAdminOrManager();
    }

    // Règle générale admin/gestionnaire, sauf les collections réservées aux
    // Cloud Functions : jetons (server_secrets) et codes des postes de caisse.
    // ({rest=**} couvre aussi les sous-collections.) Les profils (users) et les
    // invitations portent les rôles : leur écriture reste aux seules règles
    // dédiées plus haut, sinon un gestionnaire pourrait se nommer admin. Les
    // invitations ne sont pas non plus lisibles ici : leurs tokens permettent
    // d'activer un compte avec les rôles qu'elles portent.
    match /{collection}/{rest=**} {
      allow read: if isAdminOrManager() &&
        !(collection in ["server_secrets", "cashPostSecrets", "cashAccessAttempts", "invitations"]);
      allow write: if isAdminOrManager() &&
        !(collection in ["server_secrets", "cashPostSecrets", "cashAccessAttempts", "users", "invitations"]);
    }
  }
}
