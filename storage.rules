rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Doit rester alignée avec isWebsiteManager() dans firestore.rules : seuls
    // admin/gestionnaire/gestionnaire_site gèrent le contenu du site public.
    // Avant ce correctif, n'importe quel compte connecté (bénévole, chef
    // d'équipe...) pouvait écraser les logos partenaires / PDF de presse
    // publiés publiquement, alors que le document Firestore correspondant
    // était lui bien protégé.
    function isWebsiteManager() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userTypes is list &&
        (
          "admin" in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userTypes ||
          "gestionnaire" in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userTypes ||
          "gestionnaire_site" in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userTypes
        );
    }

    // Logos partenaires — lecture publique (affichés sur le site public)
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    // Communiqués de presse — lecture publique (téléchargeables sur le site)
    match /press-releases/{allPaths=**} {
      allow read: if true;
      allow write: if isWebsiteManager();
    }

    // Documents internes — lecture réservée aux utilisateurs connectés
    match /documents/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Tout autre fichier — connecté uniquement
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
